// ============================================================================
// Marketing Intelligence Dashboard — Prisma Schema
// Base de datos: PostgreSQL (Supabase)
// Principio: histórico inmutable. Nunca se sobrescriben métricas, se agregan
// nuevos snapshots (grain temporal) para poder reconstruir evolución diaria.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  GUEST
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String
  role          Role      @default(GUEST)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  reports       Report[]
}

// ---------------------------------------------------------------------------
// Marcas / Credenciales Meta
// ---------------------------------------------------------------------------

enum BrandSlug {
  informes_comerciales
  inversiones_cinco
  segal_deudores
}

model Brand {
  id                  String       @id @default(cuid())
  slug                BrandSlug    @unique
  name                String
  logoUrl             String?
  themeColor          String?      // hex, usado en charts comparativos
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  // Credenciales (encriptadas a nivel de aplicación antes de persistir)
  metaCredential      MetaCredential?
  tiktokCredential    TiktokCredential?
  linkedinCredential  LinkedinCredential?

  campaigns           Campaign[]
  posts               Post[]
  metricSnapshots     MetricSnapshot[]
  alerts              Alert[]
  aiInsights          AiInsight[]
  gaCredential        GaCredential?
  gaMetricSnapshots   GaMetricSnapshot[]
  gaTrafficSources    GaTrafficSource[]
  gaLandingPages      GaLandingPage[]
  gaEvents            GaEvent[]
  followerSnapshots   FollowerSnapshot[]
}

model MetaCredential {
  id                  String   @id @default(cuid())
  brandId             String   @unique
  brand               Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)

  accessTokenEnc      String   // Meta Access Token (encriptado, AES-256-GCM)
  adAccountId         String   // act_XXXXXXXXXX
  facebookPageId       String?
  instagramBusinessId String?

  tokenExpiresAt      DateTime?
  lastSyncedAt        DateTime?
  syncStatus          String?   // idle | syncing | error
  syncError           String?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model AppSettings {
  id                  String   @id @default(cuid())
  openaiApiKeyEnc     String?
  autoSyncEnabled     Boolean  @default(true)
  autoSyncIntervalHrs Int      @default(6)
  benchmarkCountry    String   @default("CL")

  // Branding — configurable desde Configuración, sin tocar código
  platformName        String   @default("Marketing Segal")
  companyName         String   @default("Segal")
  logoDataUrl          String?  @db.Text // imagen embebida como data URL (base64)
  faviconDataUrl       String?  @db.Text
  primaryColor        String   @default("#6E56CF")
  secondaryColor      String   @default("#3FBF8F")

  updatedAt           DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Google Analytics 4
// ---------------------------------------------------------------------------

model TiktokCredential {
  id             String    @id @default(cuid())
  brandId        String    @unique
  brand          Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)

  accessTokenEnc String    // TikTok Access Token (encriptado, AES-256-GCM)
  openId         String    // Open ID de la cuenta de negocio de TikTok

  lastSyncedAt   DateTime?
  syncStatus     String?   // idle | syncing | error
  syncError      String?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model LinkedinCredential {
  id              String    @id @default(cuid())
  brandId         String    @unique
  brand           Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)

  accessTokenEnc  String    // LinkedIn Access Token (encriptado, AES-256-GCM)
  organizationUrn String    // ej: urn:li:organization:12345678

  lastSyncedAt    DateTime?
  syncStatus      String?   // idle | syncing | error
  syncError       String?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model GaCredential {
  id                    String   @id @default(cuid())
  brandId               String   @unique
  brand                 Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)

  propertyId            String   // GA4 Property ID, ej: "properties/123456789"
  serviceAccountJsonEnc  String   // JSON de la Service Account, encriptado (AES-256-GCM)

  lastSyncedAt          DateTime?
  syncStatus            String?   // idle | syncing | error
  syncError             String?

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model GaMetricSnapshot {
  id                String       @id @default(cuid())
  brandId           String
  brand             Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)

  grain             MetricGrain  @default(DAILY)
  date              DateTime

  users             Int
  newUsers          Int
  sessions          Int
  engagedSessions   Int
  engagementRate    Decimal      @db.Decimal(8, 4)
  avgEngagementSec  Decimal      @db.Decimal(10, 2)
  pageViews         Int
  eventCount        Int
  conversions       Int
  conversionRate    Decimal      @db.Decimal(8, 4)

  createdAt         DateTime     @default(now())

  @@unique([brandId, grain, date])
  @@index([brandId, grain, date])
}

model GaTrafficSource {
  id                String       @id @default(cuid())
  brandId           String
  brand             Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)

  date              DateTime
  channel           String       // Organic Search, Paid Social, Direct, etc.
  source             String?      // google, facebook, instagram, (direct)...
  users             Int
  sessions          Int
  engagementRate    Decimal      @db.Decimal(8, 4)
  conversions       Int
  avgEngagementSec  Decimal      @db.Decimal(10, 2)

  createdAt         DateTime     @default(now())

  @@index([brandId, date])
}

model GaLandingPage {
  id                String       @id @default(cuid())
  brandId           String
  brand             Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)

  date              DateTime
  path              String
  title             String?
  users             Int
  sessions          Int
  engagementRate    Decimal      @db.Decimal(8, 4)
  conversions       Int
  avgEngagementSec  Decimal      @db.Decimal(10, 2)
  exitRate          Decimal      @db.Decimal(8, 4)

  createdAt         DateTime     @default(now())

  @@index([brandId, date])
}

model GaEvent {
  id                String       @id @default(cuid())
  brandId           String
  brand             Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)

  date              DateTime
  eventName         String       // page_view, generate_lead, form_submit...
  eventCount        Int
  totalUsers        Int
  isConversion      Boolean      @default(false)
  conversionValue    Decimal?     @db.Decimal(14, 2)

  createdAt         DateTime     @default(now())

  @@index([brandId, date, eventName])
}

// ---------------------------------------------------------------------------
// Campañas / Ad Sets / Ads (Meta Marketing API)
// ---------------------------------------------------------------------------

enum CampaignStatus {
  ACTIVE
  PAUSED
  COMPLETED
  DELETED
}

enum CampaignObjective {
  LEADS
  TRAFFIC
  ENGAGEMENT
  CONVERSIONS
  AWARENESS
  APP_PROMOTION
  SALES
}

model Campaign {
  id                String            @id @default(cuid())
  metaCampaignId    String            @unique
  brandId           String
  brand             Brand             @relation(fields: [brandId], references: [id], onDelete: Cascade)

  name              String
  objective         CampaignObjective
  status            CampaignStatus
  dailyBudget       Decimal?          @db.Decimal(14, 2)
  lifetimeBudget    Decimal?          @db.Decimal(14, 2)
  startDate         DateTime
  endDate           DateTime?

  adSets            AdSet[]
  metricSnapshots   MetricSnapshot[]
  posts             Post[]

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model AdSet {
  id            String    @id @default(cuid())
  metaAdSetId   String    @unique
  campaignId    String
  campaign      Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  name          String
  status        CampaignStatus
  ads           Ad[]
  createdAt     DateTime  @default(now())
}

model Ad {
  id          String   @id @default(cuid())
  metaAdId    String   @unique
  adSetId     String
  adSet       AdSet    @relation(fields: [adSetId], references: [id], onDelete: Cascade)
  name        String
  status      CampaignStatus
  creativeUrl String?
  createdAt   DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Métricas — grain temporal (histórico inmutable, nunca se sobrescribe)
// ---------------------------------------------------------------------------

enum MetricGrain {
  DAILY
  WEEKLY
  MONTHLY
}

model MetricSnapshot {
  id                String       @id @default(cuid())
  brandId           String
  brand             Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  campaignId        String?
  campaign          Campaign?    @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  grain             MetricGrain  @default(DAILY)
  date              DateTime     // fecha de referencia del snapshot (día/semana/mes)

  spend             Decimal      @db.Decimal(14, 2)
  reach             Int
  impressions       Int
  clicks            Int
  ctr               Decimal      @db.Decimal(8, 4)
  cpc               Decimal      @db.Decimal(10, 2)
  cpm               Decimal      @db.Decimal(10, 2)
  leads             Int          @default(0)
  cpl               Decimal?     @db.Decimal(10, 2)
  conversions       Int          @default(0)
  conversionRate    Decimal?     @db.Decimal(8, 4)
  roas              Decimal?     @db.Decimal(8, 2)
  frequency         Decimal      @db.Decimal(6, 3)
  engagement        Int          @default(0) // likes + comentarios + compartidos + guardados de los anuncios (post_engagement de Meta)

  createdAt         DateTime     @default(now())

  @@unique([brandId, campaignId, grain, date])
  @@index([brandId, grain, date])
}

// ---------------------------------------------------------------------------
// Contenidos (Meta Graph API — Facebook / Instagram)
// ---------------------------------------------------------------------------

enum SocialNetwork {
  FACEBOOK
  INSTAGRAM
  TIKTOK
  LINKEDIN
}

enum PostType {
  REEL
  CAROUSEL
  IMAGE
  STORY
  VIDEO
}

enum PostFundingType {
  ORGANIC
  PAID
}

// ---------------------------------------------------------------------------
// Seguidores — histórico por red social (nunca se sobrescribe)
// ---------------------------------------------------------------------------

model FollowerSnapshot {
  id            String        @id @default(cuid())
  brandId       String
  brand         Brand         @relation(fields: [brandId], references: [id], onDelete: Cascade)

  network       SocialNetwork
  date          DateTime

  followers     Int
  newFollowers  Int           @default(0)

  createdAt     DateTime      @default(now())

  @@unique([brandId, network, date])
  @@index([brandId, network, date])
}

model Post {
  id              String          @id @default(cuid())
  metaPostId      String          @unique
  brandId         String
  brand           Brand           @relation(fields: [brandId], references: [id], onDelete: Cascade)
  campaignId      String?
  campaign        Campaign?       @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  network         SocialNetwork
  type            PostType
  fundingType     PostFundingType
  publishedAt     DateTime
  mediaUrl        String?
  thumbnailUrl    String?
  copy            String?         @db.Text
  permalink       String?

  reach           Int             @default(0)
  impressions     Int             @default(0)
  plays           Int             @default(0)
  likes           Int             @default(0)
  comments        Int             @default(0)
  shares          Int             @default(0)
  saves           Int             @default(0)
  engagement      Int             @default(0)
  clicks          Int             @default(0)
  ctr             Decimal?        @db.Decimal(8, 4)
  spend           Decimal?        @db.Decimal(14, 2)
  leads           Int             @default(0)
  cpl             Decimal?        @db.Decimal(10, 2)

  performanceScore Int?           // 0-100, calculado

  // Curva de retención de video — dato real que entrega Meta, no generado
  // por IA. avgWatchPct = video_avg_time_watched / duración. Los p25-p95
  // son el % de espectadores que llegó a ese punto del video.
  videoDurationSec  Int?
  avgWatchPct       Decimal?       @db.Decimal(5, 2)
  retentionP25      Decimal?       @db.Decimal(5, 2)
  retentionP50      Decimal?       @db.Decimal(5, 2)
  retentionP75      Decimal?       @db.Decimal(5, 2)
  retentionP95      Decimal?       @db.Decimal(5, 2)

  aiInsight        AiInsight?

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([brandId, publishedAt])
  @@index([performanceScore])
}

// ---------------------------------------------------------------------------
// IA — insights por publicación y reportes ejecutivos
// ---------------------------------------------------------------------------

model AiInsight {
  id                String   @id @default(cuid())
  postId            String?  @unique
  post              Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  brandId           String
  brand             Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)

  whyItWorked        String  @db.Text
  whatToReplicate     String  @db.Text
  whatToImprove       String  @db.Text
  similarIdeas        String  @db.Text
  nextContentIdea     String  @db.Text

  // Análisis creativo profundo (solo video, generado bajo demanda — no en
  // cada sincronización, por costo). Null si nunca se pidió o el post no
  // es video.
  transcript          String? @db.Text  // guion real, transcrito con Whisper
  hookAnalysis         String? @db.Text  // qué pasa en los primeros 3 seg
  ganchoAnalysis       String? @db.Text  // qué mantiene la atención en el desarrollo
  cierreAnalysis        String? @db.Text  // cómo termina / CTA
  toneOfVoice          String? @db.Text
  scenario              String? @db.Text  // ambientación, locación, iluminación
  cameraWork            String? @db.Text  // movimientos de cámara, cortes, ritmo de edición
  pacingAssessment      String? @db.Text  // si es muy lento/rápido para el formato
  retentionDropAnalysis String? @db.Text  // qué pasaba en el video en el punto donde cae la retención
  creativeAnalyzedAt    DateTime?

  model             String   @default("gpt-4o")
  createdAt         DateTime @default(now())
}

enum ReportType {
  EXECUTIVE_MONTHLY
  CUSTOM
}

enum ReportFormat {
  PDF
  XLSX
  CSV
}

model Report {
  id          String        @id @default(cuid())
  createdById String
  createdBy   User          @relation(fields: [createdById], references: [id])
  type        ReportType
  format      ReportFormat
  periodStart DateTime
  periodEnd   DateTime
  fileUrl     String?
  summary     String?       @db.Text
  createdAt   DateTime      @default(now())
}

// ---------------------------------------------------------------------------
// Alertas
// ---------------------------------------------------------------------------

enum AlertType {
  CTR_DROP
  CPL_INCREASE
  CAMPAIGN_STOPPED_DELIVERY
  HIGH_FREQUENCY
  BUDGET_DEPLETING
  ENGAGEMENT_DROP
  FOLLOWER_DROP
  POST_UNDERPERFORMING
  LANDING_PAGE_ABANDONMENT
  CAMPAIGN_NO_RESULTS
  SYNC_ERROR
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

model Alert {
  id             String        @id @default(cuid())
  brandId        String
  brand          Brand         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  campaignId     String?
  type           AlertType
  severity       AlertSeverity
  message        String
  recommendation String        @default("")
  isRead         Boolean       @default(false)
  createdAt      DateTime      @default(now())

  @@index([brandId, isRead])
}
